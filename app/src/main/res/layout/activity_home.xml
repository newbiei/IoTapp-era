<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:fitsSystemWindows="true"
    android:clipToPadding="false"
    android:id="@+id/homeScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    tools:context=".ui.home.HomeActivity">

    <!-- AppBar -->
    <LinearLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:paddingTop="?attr/actionBarSize"
        android:background="?android:colorBackground"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WERA IOT"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="?android:textColor" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="10" />

        <ImageButton
            android:id="@+id/btnAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_add"
            android:contentDescription="Add"
            app:tint="?android:textColor" />

        <ImageButton
            android:id="@+id/btnNotif"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_notification"
            android:contentDescription="Notification"
            app:tint="?android:textColor" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings"
            android:contentDescription="Settings"
            app:tint="?android:textColor" />
    </LinearLayout>

    <!-- Greeting -->
    <TextView
        android:id="@+id/tvGreeting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/greeting"
        android:textColor="?android:textColor"
        android:textSize="16sp"
        android:padding="16dp"
        android:layout_below="@id/appBar" />

    <!-- RecyclerView for device list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDeviceList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/tvGreeting"
        android:layout_above="@id/fabStartAll"
        android:paddingBottom="16dp"
        android:visibility="visible"
        tools:listitem="@layout/item_device_card" />

    <!-- Floating Action Button (Start All) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabStartAll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp"
        app:backgroundTint="?attr/colorPrimary"
        app:srcCompat="@drawable/ic_play"
        android:tint="?android:textColor"
        android:contentDescription="Start All" />

    <!-- Fragment container -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</RelativeLayout>
